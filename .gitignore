*.log
relatorios_cache.db

# Cache de metadados do script que baixa os textos-padrão do SEI
.cache_textos_padroes.json
processos_ja_vistos.json

# Node portátil extraído localmente (não versionar)
.tools/

# Exports de fluxos do Power Automate (contêm client_secret em texto puro)
flows_referencia/
