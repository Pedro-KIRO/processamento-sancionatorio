# ===== Segredos / ambiente =====
.env
.env.local
*.env
!*.env.example
*.key
*.pem

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.db
*.sqlite3
# Backups do banco (ex.: processamento.db.bak_20260729_111512).
# O padrão *.db não cobre isso, porque o sufixo vem DEPOIS da extensão —
# e esses arquivos têm centenas de MB e dados reais dos processos.
*.db.bak*
*.db-journal
*.db-wal
*.db-shm

# ===== Node / frontend =====
node_modules/
dist/
build/
.vite/

# Frontend compilado que o backend serve — é cópia de frontend/dist,
# gerada por deploy.bat. Não versionar artefato de build.
backend/static/

# ===== Sistema / IDE =====
.DS_Store
Thumbs.db
.idea/
.vscode/

# Arquivo local do tech lead (não versionar) — convenção do template DTI
TECH_LEAD.md

