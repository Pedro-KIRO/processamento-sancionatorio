# Copie para .env na raiz do monorepo e preencha. NUNCA commite o .env real.
#
# O .env é único e fica na raiz: apps/api lê via ConfigModule e apps/web lê as
# variáveis com prefixo VITE_ em tempo de build.

# =============================================================================
# Banco de dados do domínio (PostgreSQL 16)
# =============================================================================
# Um schema por domínio, conforme .kiro/steering/dados-prisma.md.
DATABASE_URL="postgresql://detran:detran_local@localhost:5432/processamento?schema=processamento"

# =============================================================================
# Autenticação (ver .kiro/steering/permissionamento.md)
# =============================================================================
# "dev" → identidade simulada por DEV_USER / header x-dev-user, SEM validar token.
# "sso" → token do Microsoft Entra ID validado por JWKS.
# NUNCA use "dev" em homologação ou produção.
AUTH_MODE="dev"

# E-mail do usuário a simular em AUTH_MODE=dev. Precisa existir em
# gestao_acessos_v2.tb_usuarios — o modo dev encurta a prova de identidade,
# mas não dispensa o cadastro.
#
# Este valor já vem cadastrado como Gestor Principal pelo seed local
# (prisma/dev/gestao_acessos_v2.sql), então o app funciona sem configurar o
# catálogo de permissões. Para testar 403, troque por analista@detran.sp.gov.br
# ou envie o header x-dev-user na requisição.
DEV_USER="dev@detran.sp.gov.br"

# Entra ID (obrigatórias quando AUTH_MODE=sso)
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_AUDIENCE=""

# =============================================================================
# Permissões — banco do Gestão de Acessos (SOMENTE LEITURA)
# =============================================================================
# Obrigatória. Sem ela o módulo de permissões não inicializa (throw no construtor).
#
# Em desenvolvimento aponta para o Postgres local, onde o seed
# prisma/dev/gestao_acessos_v2.sql cria o schema. Em homologação e produção,
# aponte para o banco do Gestão de Acessos com um usuário que tenha SOMENTE
# permissão de SELECT no schema gestao_acessos_v2.
PERMISSIONS_DATABASE_URL="postgresql://detran:detran_local@localhost:5432/processamento?schema=gestao_acessos_v2"

# =============================================================================
# Porta da API
# =============================================================================
# Convenção da plataforma: backend 3001, frontend 3000 (contêiner) / 5173 (dev).
PORT=3001

# =============================================================================
# Ponte de migração (TEMPORÁRIA — remover quando o backend Python sair)
# =============================================================================
# Caminhos /api ainda não portados para o NestJS são repassados para o FastAPI.
# Ver apps/api/src/app/legacy/legacy-proxy.middleware.ts.
LEGACY_API_URL="http://localhost:8080"
LEGACY_PROXY_ENABLED="true"

# =============================================================================
# API SEI
# =============================================================================
SEI_TOKEN_URL="https://idp.sp.gov.br/auth/realms/idpsp/protocol/openid-connect/token"
SEI_CLIENT_ID=""
SEI_CLIENT_SECRET=""
SEI_API_BASE="https://sei-processos.api.rota.sp.gov.br"
SEI_SIGLA_SISTEMA="CSDR_PROCESSAMENTO"
SEI_IDENTIFICACAO_SERVICO=""
SEI_TRACE_ID="CSDR_PROCESSAMENTO_SEI"

# Ambiente de homologação do SEI (para testes):
# SEI_API_BASE="https://sei-processos.api-hml.rota.sp.gov.br"

# =============================================================================
# Microsoft Graph / SharePoint
# =============================================================================
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
SHAREPOINT_HOSTNAME="governosp.sharepoint.com"
SHAREPOINT_SITE_PATH="/teams/DETRAN-CPSAR"

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# =============================================================================
# Frontend (prefixo VITE_ — lidas em tempo de build, ficam expostas no bundle)
# =============================================================================
# Não coloque segredo em variável VITE_.
VITE_SEI_WEB_URL="https://sei.sp.gov.br/sei"
VITE_MINHA_AREA_URL="https://minhaarea.sp.gov.br/"
VITE_ENTRA_CLIENT_ID=""
VITE_ENTRA_TENANT_ID=""
VITE_ENTRA_REDIRECT_URI="http://localhost:5173"
VITE_ENTRA_API_SCOPE=""

# Prefixo de caminho quando o frontend é servido sob /<sistema>/ em homologação.
VITE_BASE_PATH="/"

# =============================================================================
# PostgreSQL local (usado pelo docker-compose.yml)
# =============================================================================
POSTGRES_USER="detran"
POSTGRES_PASSWORD="detran_local"
POSTGRES_DB="processamento"
