# Copie para backend/.env e preencha. NUNCA commite o .env real.

# === API SEI ===
SEI_TOKEN_URL=https://idp.sp.gov.br/auth/realms/idpsp/protocol/openid-connect/token
SEI_CLIENT_ID=
SEI_CLIENT_SECRET=
SEI_API_BASE=https://sei-processos.api.rota.sp.gov.br
SEI_SIGLA_SISTEMA=CSDR_PROCESSAMENTO
SEI_IDENTIFICACAO_SERVICO=
SEI_TRACE_ID=CSDR_PROCESSAMENTO_SEI

# Aliases usados pela automação caixa_entrada_prod.py (mesmos valores acima)
CLIENT_ID=
CLIENT_SECRET=

# Ambiente de homologação do SEI (para testes):
# SEI_API_BASE=https://sei-processos.api-hml.rota.sp.gov.br

# === Microsoft Graph (migração / sync SharePoint) ===
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SHAREPOINT_HOSTNAME=governosp.sharepoint.com
SHAREPOINT_SITE_PATH=/teams/DETRAN-CPSAR

# === Banco de dados (alvo: SQL Server; local pode usar SQLite) ===
DATABASE_URL=sqlite:///./processamento.db

# === API / Autenticação (Microsoft Entra ID) ===
# Em desenvolvimento local deixe AUTH_ENABLED=false (libera sem token).
AUTH_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
# Quem pode consultar e editar os textos-padrão (tela "Textos-padrão"). Emails
# separados por vírgula. Serve enquanto os app roles do Entra ID não estiverem
# publicados; valem também a role "coordenador" no token e o perfil
# "coordenador" na tabela usuario. Com AUTH_ENABLED=true e nenhuma das três
# fontes preenchida, ninguém edita — a recusa é proposital.
COORDENADORES=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# === Publicação no GitHub (scripts/atualizar_github.py) ===
# Usado apenas para publicar o código sem ter o Git instalado na máquina.
# Token: GitHub > Settings > Developer settings > Personal access tokens >
# Fine-grained tokens. Permissão necessária: Contents (Read and write).
GITHUB_TOKEN=
GITHUB_REPO=Detran-SP/processamento-sancionatorio
